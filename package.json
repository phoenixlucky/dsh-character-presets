    "assets/preset-icons/moon-lovers-pan-an.webp",
    "assets/preset-icons/moon-lovers-lanling-wang.webp",
    "assets/preset-icons/moon-lovers-wei-jie.webp",
    "assets/preset-icons/moon-lovers-song-yu.webp",
    "assets/preset-icons/zhuge-liang-market-research.webp",
    "assets/preset-icons/wei-liao-strategy-planning.webp",
