{
  "name": "@tinyforge/dsh-character-presets",
  "version": "1.5.0",
  "license": "MIT",
  "description": "Character presets with WebP icons and colored badge chips for DeepSeek Harness Web profiles, plus financial, market research, strategy planning, cross-border ecommerce, and software engineering roles (Tauri/Rust, MCP, Vue, security, delivery, observability)",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README.zh.md",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/preset-icons"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.1",
    "@deepseek-ai/dsh-persona": "0.2.2-rc.1",
    "@deepseek-ai/dsh-time-context": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1"
  },
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
