  "dependencies": {
    "@deepseek-ai/dsh-agent-preset": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-persona": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-time-context": ">=0.2.2-rc.1 <0.3.0-0"
