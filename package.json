    "assets/preset-icons/gu-kaizhi-vue-ui.webp",
    "assets/preset-icons/mozi-security.webp",
    "assets/preset-icons/huang-daopo-delivery.webp",
    "assets/preset-icons/wang-zhenyi-observability.webp"
